# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration (Publishable Key - Safe for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_NAME=Instagram Automation SaaS
NEXT_PUBLIC_APP_VERSION=1.0.0

# Instagram OAuth (must match the Facebook app where you added Instagram Testers)
# Get from: Facebook Developer Console → Your App → Settings → Basic → App ID
NEXT_PUBLIC_INSTAGRAM_APP_ID=

# Feature Flags (Optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false
